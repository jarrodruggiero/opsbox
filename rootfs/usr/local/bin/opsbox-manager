#!/usr/bin/python3
"""Serve the opsbox manager page, and run Remote Control under it."""
# Debian's Python, by full path: it has python3-yaml, and PATH starts with
# ~/.local/bin, which lives in the volume.

import os
import signal
import sys
import threading
from pathlib import Path

sys.path.insert(0, "/usr/local/lib")

from opsbox.manager import keys, render, sessions, supervisor, web  # noqa: E402


def mirror(console: supervisor.Console) -> None:
    """Copy the console to stdout, so `docker logs` still shows Remote Control's
    output, as it did when Remote Control was the container's main process."""
    q = console.subscribe()
    while (chunk := q.get()) is not None:
        sys.stdout.buffer.write(chunk)
        sys.stdout.buffer.flush()


def main() -> int:
    home = Path(os.environ["HOME"])
    state = home / ".config/opsbox/manager"
    workdir = os.environ.get("OPSBOX_WORKDIR", str(home / "workspace"))
    Path(workdir).mkdir(parents=True, exist_ok=True)
    console = supervisor.Console()
    threading.Thread(target=mirror, args=(console,), daemon=True).start()
    rc = supervisor.RemoteControl(
        console, workdir=workdir, args=["--spawn", "same-dir", *sys.argv[1:]],
        env_file=keys.env_path(), owner_file=state / "owner",
    )
    manager = web.Manager(
        home=home, rc=rc, console=console,
        sessions=sessions.Sessions(state),
        render=render.page,
        static_dir=Path("/usr/local/lib/opsbox/manager/static"),
        hosts=os.environ.get("OPSBOX_MANAGER_HOSTS", "").split(","),
    )
    manager.clear_stale_signins()
    # Remote Control first: it needs no port, and a box that's already set up
    # keeps working even if the page can't listen.
    rc.start()
    done = threading.Event()
    port = int(os.environ.get("OPSBOX_MANAGER_PORT", "8080"))
    try:
        server = web.serve(manager, port=port)
    except OSError as failed:
        message = f"the manager page can't listen on port {port} ({failed.strerror}); Remote Control runs without it"
        console.note(message)
        print(f"opsbox-manager: {message}", file=sys.stderr, flush=True)
        server = None
    else:
        console.note(f"manager on port {port}")
        print(f"opsbox-manager: serving on port {port}; open http://<this box's address>:{port}/", file=sys.stderr, flush=True)

    def stop(signum: int, frame: object) -> None:
        rc.stop()
        done.set()
        if server is not None:
            # shutdown() waits for serve_forever to return, so not from its own thread.
            threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    if server is not None:
        server.serve_forever()
    else:
        done.wait()
    return 0


if __name__ == "__main__":
    sys.exit(main())
