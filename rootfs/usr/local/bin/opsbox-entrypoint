#!/usr/bin/env bash
#
# opsbox-entrypoint - serve the manager page and run Remote Control under it,
# run Remote Control directly, or run a command.
# See usage() or --help for details.

set -euo pipefail

# ---------------------------------------------------------------------------
# constants
# ---------------------------------------------------------------------------

readonly SCRIPT_NAME="${0##*/}"
readonly WORKDIR="${OPSBOX_WORKDIR:-$HOME/workspace}"
readonly SIGN_IN_POLL_SECONDS=30
readonly SIGN_IN_REMIND_SECONDS=900
# By full path: PATH starts with ~/.local/bin, which lives in the volume, so
# anything that ever wrote a `claude` there would otherwise become the Remote
# Control server on every start, through every image upgrade.
readonly CLAUDE=/usr/bin/claude

# ---------------------------------------------------------------------------
# usage and utilities
# ---------------------------------------------------------------------------

# usage - print how to invoke this script.
usage() {
  cat <<EOF
Usage: opsbox-entrypoint [manager [OPTIONS...]]
       opsbox-entrypoint remote-control [OPTIONS...]
       opsbox-entrypoint COMMAND [ARGS...]

With manager (the image's default command) or no arguments: serve the
manager page on port 8080, and run claude remote-control --spawn same-dir
OPTIONS... in WORKDIR under it. Open http://<this box>:8080/ to sign in to
Claude, answer the trust question and manage the keys.

With remote-control: wait until Claude Code is signed in, then run claude
remote-control OPTIONS... in WORKDIR directly, without the page. Sign in
with docker exec -it <container> claude auth login, and on the first start
docker attach <container> to answer the trust question, detaching with
Ctrl-P Ctrl-Q.

Any other COMMAND runs as given, for example bash or opsbox-versions.

Environment:
  OPSBOX_WORKDIR        the directory sessions start in (default
                        $HOME/workspace). It must not be $HOME itself, because
                        Claude Code never saves a trust answer for the home
                        directory.
  OPSBOX_MANAGER_PORT   the manager page's port (default 8080).
  OPSBOX_MANAGER_HOSTS  names, comma-separated, that the page answers to
                        besides IP addresses, for example opsbox.home.
EOF
}

# die - print an error message and exit.
die() {
  echo "${SCRIPT_NAME}: error: $*" >&2; exit 1
}

# log - print a log message to stderr.
log() {
  echo "${SCRIPT_NAME}: $*" >&2
}

# check_home - ensure HOME is writable, and private, die otherwise.
check_home() {
  if [ ! -w "$HOME" ]; then
    die "\$HOME ($HOME) is not writable (uid=$(id -u) gid=$(id -g)); mount a volume at \$HOME owned by them, for example by running chown $(id -u):$(id -g) on the host directory."
  fi
  # A bind-mounted directory arrives with whatever mode `mkdir` gave it on the
  # host, usually 0755: the keys in it would be readable by every user there.
  chmod go-rwx "$HOME"
}

# ---------------------------------------------------------------------------
# sign-in
# ---------------------------------------------------------------------------

# auth_method - print how Claude Code is signed in, from `claude auth status`:
# none, claude.ai, claude.ai+api-key (a sign-in with an API key set as well),
# or another method (api_key, oauth_token, api_key_helper, third_party).
auth_method() {
  local status
  status="$("$CLAUDE" auth status 2>/dev/null)" || true
  jq -r '
    if (.loggedIn | not) then "none"
    elif .authMethod == "claude.ai" and ((.apiKeySource // "none") != "none") then "claude.ai+api-key"
    else .authMethod end' <<<"$status" 2>/dev/null || echo none
}

# sign_in_problem <method> - print what stops Remote Control starting, if
# anything. Only a claude.ai sign-in can start it. Anything else counts as
# signed in, but `claude remote-control` would exit and the container would
# restart in a loop without ever saying why.
sign_in_problem() {
  case "$1" in
    claude.ai) ;;
    none)
      echo "not signed in to Claude Code yet; from the Docker host run: docker exec -it <container> claude auth login"
      ;;
    claude.ai+api-key)
      echo "signed in, but an API key is set as well (ANTHROPIC_API_KEY, or an env block in settings), and Remote Control refuses that; remove it"
      ;;
    *)
      echo "signed in with ${1:-an unknown method}, which can't start Remote Control; it needs a claude.ai sign-in: docker exec -it <container> claude auth login"
      ;;
  esac
}

# wait_for_sign_in - wait until claude is signed in, logging reminders.
wait_for_sign_in() {
  local waited=0 problem
  while problem="$(sign_in_problem "$(auth_method)")" && [[ -n "$problem" ]]; do
    if (( waited % SIGN_IN_REMIND_SECONDS == 0 )); then
      log "$problem"
    fi
    sleep "$SIGN_IN_POLL_SECONDS"
    (( waited += SIGN_IN_POLL_SECONDS )) || true
  done
}

# check_workdir - die if WORKDIR is HOME itself, then create it.
check_workdir() {
  # Resolved, so a trailing slash or a /. can't sneak $HOME past the check.
  if [ "$(realpath -m -- "$WORKDIR")" = "$(realpath -m -- "$HOME")" ]; then
    die "OPSBOX_WORKDIR is \$HOME; use a directory under it, because Claude Code never saves a trust answer for the home directory"
  fi
  mkdir -p "$WORKDIR"
}

# run_manager - check HOME and WORKDIR, then exec the manager, which serves
# the page and runs Remote Control under it.
run_manager() {
  check_home
  check_workdir
  exec /usr/local/bin/opsbox-manager "$@"
}

# run_remote_control - check HOME, create WORKDIR, wait for sign-in, exec.
run_remote_control() {
  check_home
  check_workdir
  wait_for_sign_in
  cd "$WORKDIR"
  log "starting claude remote-control in $WORKDIR (first start: docker attach to answer the trust question)"
  exec "$CLAUDE" remote-control "$@"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

# main - dispatch based on first argument.
main() {
  # Files the box writes (Terraform state, clones, tokens) are for its own
  # user alone, whatever the host directory's mode.
  umask 077
  case "${1:-}" in
    -h|--help)
      usage
      exit 0
      ;;
    manager)
      shift
      run_manager "$@"
      ;;
    remote-control)
      shift
      run_remote_control "$@"
      ;;
    "")
      run_manager
      ;;
    *)
      exec "$@"
      ;;
  esac
}

main "$@"
